library ieee;
use ieee.std_logic_1164.all;

entity bin2bcd is
    port (
        binary : in  std_logic_vector(6 downto 0);
        tens   : out std_logic_vector(3 downto 0);
        unid   : out std_logic_vector(3 downto 0)
    );
end entity;

architecture comb of bin2bcd is
begin
    with binary select tens <=
        "0000" when "0000000" | "0000001" | "0000010" | "0000011" | "0000100" |
                    "0000101" | "0000110" | "0000111" | "0001000" | "0001001",
        "0001" when "0001010" | "0001011" | "0001100" | "0001101" | "0001110" |
                    "0001111" | "0010000" | "0010001" | "0010010" | "0010011",
        "0010" when "0010100" | "0010101" | "0010110" | "0010111" | "0011000" |
                    "0011001" | "0011010" | "0011011" | "0011100" | "0011101",
        "0011" when "0011110" | "0011111" | "0100000" | "0100001" | "0100010" |
                    "0100011" | "0100100" | "0100101" | "0100110" | "0100111",
        "0100" when "0101000" | "0101001" | "0101010" | "0101011" | "0101100" |
                    "0101101" | "0101110" | "0101111" | "0110000" | "0110001",
        "0101" when "0110010" | "0110011" | "0110100" | "0110101" | "0110110" |
                    "0110111" | "0111000" | "0111001" | "0111010" | "0111011",
        "0110" when "0111100" | "0111101" | "0111110" | "0111111" | "1000000" |
                    "1000001" | "1000010" | "1000011" | "1000100" | "1000101",
        "0111" when "1000110" | "1000111" | "1001000" | "1001001" | "1001010" |
                    "1001011" | "1001100" | "1001101" | "1001110" | "1001111",
        "1000" when "1010000" | "1010001",
        "0000" when others;

    with binary select unid <=
        "0000" when "0000000" | "0001010" | "0010100" | "0011110" | "0101000" |
                    "0110010" | "0111100" | "1000110" | "1010000",
        "0001" when "0000001" | "0001011" | "0010101" | "0011111" | "0101001" |
                    "0110011" | "0111101" | "1000111" | "1010001",
        "0010" when "0000010" | "0001100" | "0010110" | "0100000" | "0101010" |
                    "0110100" | "0111110" | "1001000",
        "0011" when "0000011" | "0001101" | "0010111" | "0100001" | "0101011" |
                    "0110101" | "0111111" | "1001001",
        "0100" when "0000100" | "0001110" | "0011000" | "0100010" | "0101100" |
                    "0110110" | "1000000" | "1001010",
        "0101" when "0000101" | "0001111" | "0011001" | "0100011" | "0101101" |
                    "0110111" | "1000001" | "1001011",
        "0110" when "0000110" | "0010000" | "0011010" | "0100100" | "0101110" |
                    "0111000" | "1000010" | "1001100",
        "0111" when "0000111" | "0010001" | "0011011" | "0100101" | "0101111" |
                    "0111001" | "1000011" | "1001101",
        "1000" when "0001000" | "0010010" | "0011100" | "0100110" | "0110000" |
                    "0111010" | "1000100" | "1001110",
        "1001" when "0001001" | "0010011" | "0011101" | "0100111" | "0110001" |
                    "0111011" | "1000101" | "1001111",
        "0000" when others;
end architecture;