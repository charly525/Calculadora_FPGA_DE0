library ieee;
use ieee.std_logic_1164.all;

entity top_calculadora is
    port (
        sw    : in  std_logic_vector(9 downto 0);
        btn   : in  std_logic_vector(2 downto 0);
        hex3  : out std_logic_vector(6 downto 0);
        hex2  : out std_logic_vector(6 downto 0);
        hex1  : out std_logic_vector(6 downto 0);
        hex0  : out std_logic_vector(6 downto 0);
        ledg  : out std_logic_vector(9 downto 0)
    );
end entity;

architecture structural of top_calculadora is
    signal a, b       : std_logic_vector(3 downto 0);
    signal op         : std_logic_vector(1 downto 0);
    signal result     : std_logic_vector(7 downto 0);
    signal sign       : std_logic;
    signal tens, unid : std_logic_vector(3 downto 0);
    signal a_valid, b_valid, error : std_logic;
    signal modo       : std_logic_vector(2 downto 0);
    signal hex_mode, comp_mode, test_mode : std_logic;
    signal a_gt_b, a_eq_b, a_lt_b : std_logic;
    signal comp_val   : std_logic_vector(3 downto 0);
    signal comp_tens, comp_unid : std_logic_vector(3 downto 0);

    signal bcd3, bcd2, bcd1, bcd0 : std_logic_vector(3 downto 0);
    signal blank_i : std_logic;
    signal error_led : std_logic;
begin
    a  <= sw(3 downto 0);
    b  <= sw(7 downto 4);
    op <= sw(9 downto 8);

    blank_i <= '0';

    prio: entity work.codificador_prioridad
        port map (btn => btn, modo => modo);

    modos: entity work.logica_modos
        port map (modo => modo, bcd_en => open, hex_mode => hex_mode,
                  comp_mode => comp_mode, test_mode => test_mode);

    val: entity work.validador_bcd
        generic map (N => 4)
        port map (a => a, b => b, enable => not hex_mode,
                  a_valid => a_valid, b_valid => b_valid, error => error);

    mux_op: entity work.mux_operaciones
        generic map (N => 4)
        port map (a => a, b => b, op => op, result => result, sign => sign);

    bcd: entity work.bin2bcd
        generic map (N => 8)
        port map (binary => result, tens => tens, unid => unid);

    comp: entity work.comparador_magnitud
        generic map (N => 4)
        port map (a => a, b => b, a_gt_b => a_gt_b, a_eq_b => a_eq_b, a_lt_b => a_lt_b);

    comp_val <= a when a_gt_b = '1' else b;

    comp_bcd: entity work.bin2bcd
        generic map (N => 8)
        port map (binary => "0000" & comp_val, tens => comp_tens, unid => comp_unid);

    bcd3 <= "1011" when (modo = "000" and a_valid = '0') else
            a      when modo = "000" or modo = "001" or modo = "010" else
            "0000";

    bcd2 <= "1011" when (modo = "000" and b_valid = '0') else
            b      when modo = "000" or modo = "001" or modo = "010" else
            "0000";

    bcd1 <= "1011" when (modo = "000" and error = '1') else
            "1010" when (modo = "000" and sign = '1') else
            tens   when modo = "000" else
            result(7 downto 4) when modo = "001" else
            comp_tens when modo = "010" else
            "0000";

    bcd0 <= "1011" when (modo = "000" and error = '1') else
            unid   when modo = "000" else
            result(3 downto 0) when modo = "001" else
            comp_unid when modo = "010" else
            "0000";

    dec3: entity work.deco7seg port map (bcd => bcd3, seg => hex3, test => test_mode, blank => blank_i, hex_mode => hex_mode);
    dec2: entity work.deco7seg port map (bcd => bcd2, seg => hex2, test => test_mode, blank => blank_i, hex_mode => hex_mode);
    dec1: entity work.deco7seg port map (bcd => bcd1, seg => hex1, test => test_mode, blank => blank_i, hex_mode => hex_mode);
    dec0: entity work.deco7seg port map (bcd => bcd0, seg => hex0, test => test_mode, blank => blank_i, hex_mode => hex_mode);

    error_led <= error when hex_mode = '0' else '0';

    -- LEDs: en modo comparador muestran relaciones; en otros, resultado binario
    ledg(0) <= a_gt_b when comp_mode = '1' else result(0);
    ledg(1) <= a_eq_b when comp_mode = '1' else result(1);
    ledg(2) <= a_lt_b when comp_mode = '1' else result(2);
    ledg(7 downto 3) <= result(7 downto 3);
    ledg(8) <= sign;
    ledg(9) <= error_led;
end architecture;